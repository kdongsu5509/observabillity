            "x": 0,
            "y": 10,
            "w": 4,
            "h": 8,
            "queries": [
              {
                "source": "prometheus",
                "expr": "up{job=~\"prometheus|loki|tempo|grafana\"}"
              }
            ],
            "unit": null
          },
          {
            "id": 12,
            "title": "메모리 (RSS)",
