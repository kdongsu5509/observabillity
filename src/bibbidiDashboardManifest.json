            "x": 4,
            "y": 10,
            "w": 8,
            "h": 8,
            "queries": [
              {
                "source": "prometheus",
                "expr": "process_resident_memory_bytes{job=~\"prometheus|loki|tempo|grafana\"}"
              }
            ],
            "unit": "bytes"
          },
          {
            "id": 13,
            "title": "수집량",
            "type": "timeseries",
            "x": 12,
            "y": 10,
            "w": 8,
            "h": 8,
            "queries": [
              {
                "source": "prometheus",
                "expr": "sum(rate(loki_distributor_bytes_received_total[$__rate_interval]))"
              },
              {
                "source": "prometheus",
                "expr": "sum(rate(tempo_distributor_spans_received_total[$__rate_interval]))"
              },
              {
                "source": "prometheus",
                "expr": "sum(rate(prometheus_http_requests_total{handler=\"/api/v1/write\"}[$__rate_interval]))"
              }
            ],
            "unit": "short"
          },
          {
            "id": 14,
            "title": "Loki 수집 거부 (10분)",
            "type": "stat",
            "x": 20,
            "y": 10,
            "w": 4,
            "h": 4,
            "queries": [
              {
                "source": "prometheus",
                "expr": "round(sum(increase(loki_discarded_samples_total[10m]))) or vector(0)"
              }
            ],
            "unit": null
          },
          {
            "id": 15,
            "title": "Prometheus 시리즈",
            "type": "stat",
            "x": 20,
            "y": 14,
            "w": 4,
            "h": 4,
            "queries": [
              {
                "source": "prometheus",
                "expr": "prometheus_tsdb_head_series"
